+  r.meta.lockTiers = LK.meta; r.lockTiers = LK;
+}
+function lockMask(r, s, t, held, SC) {
+  const LK = r.lockTiers, ac = chooseAction(LK.rc, s, t, held), lj = r.tsLayerOf[ac];
+  if (LK.plant === 'nochooser') return -1;
