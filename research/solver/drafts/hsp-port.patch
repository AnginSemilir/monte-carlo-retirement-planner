+        const want = lvl(ranked.find(ai => lvl(ai) !== j0.spendLevel));
+        if (!(j.spendLevel === want && j.split === j0.split && strip({ ...j, spendLevel: j0.spendLevel }) === strip(j0))) bad.push(`${r.id} level`);
